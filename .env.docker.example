# App settings for the container stack. Copy to `.env.docker` (ignored by git) and edit. On the server the real file lives
# outside the repo (see deploy/README.md) and holds real secrets: keep its master copy in the team's password manager.
#
# The settings themselves are documented in .env.example; only what differs for containers is here.

# --- local development ---------------------------------------------------------------------------------------------
# NODE_ENV=production (the image default) switches dev-login off and marks the session cookie Secure, which a plain-HTTP
# localhost can't use. For a local run, override it:
NODE_ENV=development
DEV_LOGIN_ENABLED=true
SESSION_SECRET=local-only-not-a-secret
CLIENT_URL=http://localhost:8080
# The server refuses to start without the Discord settings even when nothing calls Discord; dev-login replaces the real
# sign-in locally, so placeholders are enough.
DISCORD_CLIENT_ID=local
DISCORD_CLIENT_SECRET=local
DISCORD_GUILD_ID=local
DISCORD_CALLBACK_URL=http://localhost:8080/auth/discord/callback
# Clan-member lookups and the Discord guild check are off without these, which is what you want locally.
TECTONIC_API_URL=
TECTONIC_API_KEY=
PLAYER_STATS_FETCH_DISABLED=true
WOM_COMPETITION_SYNC_DISABLED=true

# --- Sentry --------------------------------------------------------------------------------------------------------
# The server's own project, and the browser's (the server hands the browser its DSN, environment and release when it
# serves the page, so one image reports correctly from staging and from production). Leave both empty to switch Sentry off.
SENTRY_DSN=
CLIENT_SENTRY_DSN=

# --- production only -----------------------------------------------------------------------------------------------
# ADMIN_DISCORD_IDS=
# The four DISCORD_* settings above, with the real values (callback: https://tectonic.bingo/auth/discord/callback)
# TECTONIC_GUILD_ID=
# WOM_API_KEY=
# RUNEPROFILE_API_KEY=
# USER_AGENT_CONTACT=
