# Copy to terraform.tfvars (ignored by git) and fill in. Nothing in this file is a secret; the passphrase is not here on
# purpose (TF_VAR_state_passphrase from the password manager, see README.md).

cloudflare_account_id = "662dfb31085e7c9fe04493046d990c20"

# The public keys of the people who administer the box (the contents of each .pub file). The first is registered with
# Hetzner for root; all of them get a shell as the deploy user.
admin_public_keys = [
  "ssh-ed25519 AAAA... tectonic-box-admin",
]

# Only while a branch holds bootstrap changes main lacks (the first rebuild drill); otherwise leave it out (default: main).
# repository_ref = "infra/opentofu"

# The defaults (cpx31 in Ashburn, Ubuntu 24.04, bucket tectonic-backups) are in variables.tf; override here if needed.

# ---- the app's settings that are not secret but stay out of this public repository (app-env.tf) --------------------
# Its secrets are not here: they come from Bitwarden as TF_VAR_* (env.ps1).
discord_client_id  = "" # Discord developer portal > the application > OAuth2 > Client ID
discord_guild_id   = "" # the clan's Discord server id (right-click the server > Copy Server ID)
admin_discord_ids  = "" # comma-separated Discord user ids: the Owners
tectonic_api_url   = "" # the clan API's address
tectonic_guild_id  = "" # the clan's id in the clan API
user_agent_contact = "" # contact details for the clan APIs' User-Agent
