# Keep the build context small and the image free of anything local: dependencies and build output are recreated inside
# the image, and data, secrets and editor/CI state have no business in it.
**/node_modules
**/dist
.git
.github
.claude
.railway
.docker-data
.env
.env.*
!.env.docker.example

# Local data (uploads alone can be hundreds of MB)
server/data
server/uploads
*.db
*.db-shm
*.db-wal

# Not needed to build or run
e2e
docs
test-results
playwright-report
*.md
!README.md
