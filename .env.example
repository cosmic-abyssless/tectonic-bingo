# Discord OAuth2 credentials
# Create an app at https://discord.com/developers/applications
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret

# Where Discord should redirect after auth
# Must be added to your Discord app's OAuth2 redirect URIs
# In dev, use the Vite port (5173) so the session cookie is scoped to the same
# origin the frontend runs on. Using the backend port (3001) directly will cause
# the cookie to be set for :3001 while the frontend makes requests from :5173,
# breaking session persistence across page refreshes.
DISCORD_CALLBACK_URL=http://localhost:5173/auth/discord/callback

# Session secret - use a long random string in production
SESSION_SECRET=change_this_to_a_random_secret

# Frontend URL (used for CORS and post-auth redirects)
CLIENT_URL=http://localhost:5173

# ID of the Tectonic Discord guild
DISCORD_GUILD_ID=your_guild_id

# Comma-separated Discord user IDs that bootstrap as site admins on login.
# Site admins can create bingos and grant mod/admin to other users from the
# admin panel — this env var is only how the first admin gets in.
ADMIN_DISCORD_IDS=your_discord_user_id

# Anthropic API key — enables AI screenshot analysis in the submission modal
# Get one at https://console.anthropic.com/
# Optional: if not set, screenshot analysis is silently disabled
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Server port
PORT=3001

# Path to the SQLite database file.
# The directory will be created automatically if it doesn't exist.
# Defaults to <server-cwd>/data/bingo.db if not set.
DB_PATH=./data/bingo.db

# Optional, non-production only: enables POST /auth/dev-login (log in as any
# existing seeded user by discordId, no real Discord OAuth) and the "seed test
# signups" dev tool in the mod panel. Never active when NODE_ENV=production,
# regardless of this value.
DEV_LOGIN_ENABLED=false

# --- Tectonic API integration (optional) ---
# Uses the clan's tectonic-api as the source of truth for clan membership,
# WOM-verified RSNs, clan points, and rank tiers
# (docs/tectonic-api-integration-plan.md). All three must be set or the
# integration is silently disabled and everything falls back to current
# behavior. Server-side only — the key is never sent to the browser.
# Local dev: `docker compose --profile dev up` in ../tectonic-api serves the
# API on :8080 with docs at /docs; API_KEY there must match this key.
TECTONIC_API_URL=http://localhost:8080
TECTONIC_API_KEY=your_tectonic_api_key
TECTONIC_GUILD_ID=your_guild_id

# --- Wise Old Man + RuneProfile (EHB, account type in the draft pool) ---
# Fetched once per signup at signup time (not live at draft time — see
# playerStatsService.ts) and persisted on the signup row, so no env var is
# required for either: both are public APIs, called by RSN directly. Data
# may go slightly stale between signup and draft day; that's an accepted
# tradeoff for a reference-only display.
# RuneProfile distinguishes group ironman variants that WOM's account type
# can't (WOM just reports "ironman" for a GIM member) — RuneProfile wins
# when both know a player; WOM is the fallback for someone who syncs to WOM
# but isn't set up with the RuneProfile RuneLite plugin.
# RUNEPROFILE_API_KEY is optional: unauthenticated RuneProfile calls are
# capped at 30 req/min per IP, a key (free, https://runeprofile.com) raises
# that to 120/min — matters more the more signups land in a short window.
RUNEPROFILE_API_KEY=
RUNEPROFILE_API_KEY=
