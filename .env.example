# Discord OAuth2 credentials
# Create an app at https://discord.com/developers/applications
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret

# Where Discord should redirect after auth
# Must be added to your Discord app's OAuth2 redirect URIs
# In dev, use the Vite port (5173) so the session cookie is scoped to the same
# origin the frontend runs on. Using the backend port (3001) directly will cause
# the cookie to be set for :3001 while the frontend makes requests from :5173,
# breaking session persistence across page refreshes.
# In production, the server itself serves the built client (see index.ts —
# static files + SPA fallback whenever client/dist exists), so there's only
# one origin: point this at that same deployed domain, e.g.
# https://your-app.up.railway.app/auth/discord/callback
DISCORD_CALLBACK_URL=http://localhost:5173/auth/discord/callback

# Session secret - use a long random string in production
SESSION_SECRET=change_this_to_a_random_secret

# Frontend URL (used for CORS and post-auth redirects). In production this is
# the one deployed domain — same value as DISCORD_CALLBACK_URL's origin, and
# also what the server serves the built client from, so CORS is same-origin
# there (this var still matters for the post-auth redirect target).
CLIENT_URL=http://localhost:5173

# ID of the Tectonic Discord guild. Membership is checked on every Discord
# login; accounts not in this server are locked out of all bingos (site
# admins excepted) until they join and log in again.
DISCORD_GUILD_ID=your_guild_id

# Comma-separated Discord user IDs that bootstrap as site admins on login.
# Site admins can create bingos and edit any board. Only the IDs listed here
# can grant site admin to other users from the admin panel.
ADMIN_DISCORD_IDS=your_discord_user_id

# JSON logs to stdout (ts, level, msg, requestId). debug | info | warn | error.
# Default info. Health checks and static files are skipped.
LOG_LEVEL=info

# Set to "production" on a real deploy (Railway included). Gates the session
# cookie's `secure` flag (browsers won't send it back over plain HTTP without
# this) and disables dev-only tools (dev-login, seed-signups) regardless of
# DEV_LOGIN_ENABLED below. Leave unset for local dev.
NODE_ENV=production

# Overrides whether the session cookie is marked Secure (sent only over HTTPS): "true" or "false". Unset means Secure exactly
# when NODE_ENV=production. Staging needs it: it runs with NODE_ENV=staging (so dev-login works there) but is served over
# HTTPS, so it sets COOKIE_SECURE=true. Leave unset everywhere else.
COOKIE_SECURE=

# Server port. Most PaaS hosts (Railway included) inject this themselves —
# leave it unset there and the platform's value wins.
PORT=3001

# Path to the SQLite database file.
# The directory will be created automatically if it doesn't exist.
# Defaults to <server-cwd>/data/bingo.db if not set.
# On Railway (or any host with an ephemeral filesystem), point this at a
# mounted volume — otherwise every redeploy starts from an empty database.
# SQLite is one process / one file: keep replica count at 1, healthcheck
# path GET /health (or GET /api/health), and replace (don't overlap) on deploy.
DB_PATH=./data/bingo.db

# Directory where uploaded submission screenshots are stored.
# Defaults to <server-cwd>/uploads if not set.
# Same caveat as DB_PATH: needs to live on a mounted volume in production, or
# every past submission's screenshot disappears on the next redeploy.
UPLOADS_DIR=

# Optional, non-production only: enables POST /auth/dev-login (log in as any
# existing seeded user by discordId, no real Discord OAuth) and the "seed test
# signups" dev tool in the mod panel, the request-clock and OCR-skip headers,
# and /api/dev/* that the test data generator uses (docs/test-data-generator.md,
# which also lists the other variables to set when running it). Never active
# when NODE_ENV=production, regardless of this value.
DEV_LOGIN_ENABLED=false

# --- Tectonic API integration (optional) ---
# Uses the clan's tectonic-api as the source of truth for clan membership,
# WOM-verified RSNs, clan points, and rank tiers
# (docs/tectonic-api-integration-plan.md). All three must be set or the
# integration is silently disabled and everything falls back to current
# behavior. Server-side only — the key is never sent to the browser.
# Local dev: `docker compose --profile dev up` in ../tectonic-api serves the
# API on :8080 with docs at /docs; API_KEY there must match this key.
# Railway private networking does no port mapping, so the URL must include
# the API's port: http://${{API.RAILWAY_PRIVATE_DOMAIN}}:${{API.PORT}}.
# A wrong URL surfaces as `[tectonic] request failed ... fetch failed` in the
# server log and 503s on signup.
TECTONIC_API_URL=http://localhost:8080
TECTONIC_API_KEY=your_tectonic_api_key
TECTONIC_GUILD_ID=your_guild_id

# --- Wise Old Man + RuneProfile (EHB, account type in the draft pool) ---
# Fetched once per signup at signup time (not live at draft time — see
# playerStatsService.ts) and persisted on the signup row. Both APIs work
# unauthenticated; keys are optional and only raise rate limits.
# RuneProfile distinguishes group ironman variants that WOM's account type
# can't (WOM just reports "ironman" for a GIM member) — RuneProfile wins
# when both know a player; WOM is the fallback for someone who syncs to WOM
# but isn't set up with the RuneProfile RuneLite plugin.
# WOM_API_KEY is optional: unauthenticated WOM calls are capped at 20 req/min
# per IP; a key (ask on https://wiseoldman.net/discord) raises that to 100.
WOM_API_KEY=
# RUNEPROFILE_API_KEY is optional: unauthenticated RuneProfile calls are
# capped at 30 req/min per IP, a key (free, https://runeprofile.com) raises
# that to 120/min — matters more the more signups land in a short window.
RUNEPROFILE_API_KEY=

# Contact info sent in the User-Agent of every outbound API call (WOM,
# RuneProfile, OSRS wiki, tectonic-api). WOM's API rules ask for a way to
# reach the operator and IP-ban anonymous abusers, so put a Discord handle or
# email here. Defaults to the project's GitHub URL when empty.
USER_AGENT_CONTACT=

# Test hook only — set by the E2E suite (docs/e2e-testing-plan.md), never in
# a real .env. Skips the WOM/RuneProfile fetch at signup time entirely, so
# tests never hit those live APIs.
PLAYER_STATS_FETCH_DISABLED=

# Screenshot analysis (submission modal) runs local OCR (ppu-paddle-ocr) —
# no API key needed, on by default. Test hook only: set by the E2E suite
# (docs/e2e-testing-plan.md) to skip the ~30MB first-run model download,
# never in a real .env.
SCREENSHOT_OCR_DISABLED=

# Error monitoring (Sentry, org tectonic-l9). Both are optional: with no DSN, Sentry is off and nothing is sent.
# SENTRY_DSN is read by the server at runtime; VITE_SENTRY_DSN is baked into the client at BUILD time (set it where the
# client is built). They are different projects (tectonic-server, tectonic-client) with different DSNs.
SENTRY_DSN=
VITE_SENTRY_DSN=
# Build-time only, for uploading the client's source maps so browser stack traces are readable. Create it in Sentry under
# Settings > Auth Tokens with the "project:releases" and "org:read" scopes. Never commit it.
SENTRY_AUTH_TOKEN=
# Optional: the environment name Sentry reports (default: Railway's environment name, else NODE_ENV) and the share of
# requests traced (0-1, default 0.1).
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=

# OCR is CPU-heavy, so at most this many screenshots are read at once and the rest queue
# (people waiting on the submission modal go before background analysis of saved
# submissions). Default 5. In the container stack this setting belongs to the separate
# `ocr` service (docker-compose.yml sets it to 1 there); here it applies to whichever
# process reads the screenshots.
OCR_CONCURRENCY=

# Where screenshots are read. Unset (the default, and what local development wants):
# inside the API process. Set to the address of the separate OCR service (the container
# stack sets http://ocr:8080): every screenshot is sent there instead, and analysis
# answers 503 while it is unreachable rather than falling back to reading in-process.
OCR_URL=
# How long (ms) to wait for that service before giving up on a screenshot. Default 20000.
OCR_TIMEOUT_MS=
# Threads one reading may use. Default: the CPUs the process may actually use (the
# container's CPU limit, not the host's: onnxruntime otherwise oversubscribes and runs
# several times slower). Only the process that reads screenshots looks at it.
OCR_THREADS=

# Load the OCR model in the background at startup so the first screenshot after a
# deploy isn't slow. On by default when NODE_ENV=production; set "true" or "false"
# to force it either way.
OCR_WARMUP=

# OSRS item search (admin TaskEditor) hits the OSRS Wiki's public API — no
# key needed, on by default. Test hook only: set by the E2E suite so tests
# never hit the live wiki.
OSRS_ITEM_SEARCH_DISABLED=

# Wise Old Man competition sync (womCompetitionService.ts) — no env var
# needed: it's configured per bingo (enable toggle, group ID, group
# verification code) from that bingo's admin settings panel, not globally.
# Test hook only: set by the E2E suite to skip the WOM create/edit-competition
# calls entirely, never in a real .env.
WOM_COMPETITION_SYNC_DISABLED=
