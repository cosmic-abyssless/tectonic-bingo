{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node --enable-source-maps dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed:dev": "tsx src/db/seed-dev.ts",
    "db:wipe": "tsx scripts/wipe-db.ts",
    "wiki-icons:warm": "tsx scripts/warm-wiki-icons.ts",
    "db:reset": "npm run db:wipe && npm run db:generate && npm run db:migrate && npm run db:seed:dev",
    "generate-bingo": "tsx scripts/generate-bingo/generate.ts",
    "generate-bingo:teardown": "tsx scripts/generate-bingo/teardown.ts",
    "typecheck:scripts": "tsc --noEmit -p scripts/tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@discordjs/rest": "^2.6.0",
    "@sentry/node": "^10.75.0",
    "@types/multer": "^2.0.0",
    "@types/ws": "^8.18.1",
    "better-sqlite3": "^12.6.2",
    "better-sqlite3-session-store": "^0.1.0",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "discord-api-types": "^0.38.40",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.1",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "multer": "^2.0.2",
    "onnxruntime-node": "^1.29.0",
    "passport": "^0.7.0",
    "passport-discord": "^0.1.4",
    "ppu-paddle-ocr": "^6.4.3",
    "sharp": "^0.34.3",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.1",
    "@types/node": "^22.13.4",
    "@types/passport": "^1.0.17",
    "@types/passport-discord": "^0.1.12",
    "drizzle-kit": "^0.31.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
