node_modules/
dist/
.env
*.js.map
server/data/*.db
server/data/*.db-shm
server/data/*.db-wal
server/data/*.building
# Local-only files at the repo root: DB copies, endpoint notes, and raw data pulled from old sites for historical
# imports (server/scripts/historical/), which includes Players' details and screenshots.
/data/
server/uploads/
server/*.sqlite.bak
.db-backups
test-results/
playwright-report/
.claude/settings.local.json
# Sentry CLI auth token, if a login ever saves it in this folder instead of globally
.sentryclirc

# Pinned Railway plan artifacts (see .railway/README.md)
railway-plan.json

# Local container stack (docker-compose.yml): its data and settings
.docker-data/
.env.docker

# Backup credentials (see deploy/backup.env.example)
deploy/backup.env

# OpenTofu (infra/): providers, state (encrypted, but never here) and the variables file
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.*
infra/*.tfvars
infra/*.tfplan

# Board exports (the settings page's Export): big, with tile images embedded. Keep a local copy at the repo root
# for generate-bingo and the real-board test (docs/generate-bingo.md).
*-bingo-export.json

# Historical Bingo bundles made by server/scripts/historical (uploaded, not committed)
*.historical.json
