# Where backups go, and the credentials to write and read them. Copy to `backup.env` (ignored by git) and fill in. On the
# server it lives outside the repo; its master copy belongs in the team's password manager, because rebuilding the box
# needs it before anything else can be restored.
#
# Read by the litestream and backup containers (deploy/compose.backup.yml) and by deploy/restore.sh.

# Cloudflare R2: the S3 API address of the account, https://<ACCOUNT_ID>.r2.cloudflarestorage.com
BACKUP_ENDPOINT=
# The bucket, created once by hand in the Cloudflare dashboard.
BACKUP_BUCKET=
# One folder per environment inside the bucket. Never let two environments share one: they would overwrite each other's
# history. The database is replicated to <prefix>/db and the uploads to <prefix>/uploads.
BACKUP_PREFIX=production
# An R2 API token limited to this one bucket with Object Read & Write. Not a token for the whole account.
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=

# Optional but strongly advised: a dead-man's-switch URL (healthchecks.io or similar). The nightly uploads backup calls
# it on success and at <url>/fail on failure, so a backup that silently stops shows up as an alert instead of as a
# surprise on the day you need it.
BACKUP_PING_URL=

# Optional. The time of day (UTC, HH:MM) the uploads backup runs. It also runs once when its container starts.
BACKUP_AT=03:15
# Optional. "Cloudflare" for R2 (the default); "Other" for any other S3-compatible store (the local restore drill).
BACKUP_S3_PROVIDER=Cloudflare
