# Production's settings and secrets. Copy to /srv/tectonic/env/production.env on the box (mode 640, owned by the deploy
# user) and fill it in. It is NOT in git. Keep the master copy in the team's password manager: rebuilding the box needs it.
#
# Every setting is documented in .env.example at the repository root; this file lists the ones production needs. The
# image sets NODE_ENV=production itself, which turns dev-login off and marks the session cookie Secure.

# --- the site's address ----------------------------------------------------------------------------------------------
CLIENT_URL=https://tectonic.bingo
DISCORD_CALLBACK_URL=https://tectonic.bingo/auth/discord/callback

# --- Discord (developer portal, application "Tectonic Bingo") --------------------------------------------------------
# The callback above must be registered under OAuth2 > Redirects, next to the old tectonic.cc one until Railway is gone.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
# Comma-separated Discord user ids that become site admins on first login.
ADMIN_DISCORD_IDS=

# --- session ---------------------------------------------------------------------------------------------------------
# A long random string, different from every other environment's. Changing it signs everyone out.
SESSION_SECRET=

# --- clan integrations -----------------------------------------------------------------------------------------------
TECTONIC_API_URL=
TECTONIC_API_KEY=
TECTONIC_GUILD_ID=
WOM_API_KEY=
RUNEPROFILE_API_KEY=
USER_AGENT_CONTACT=

# --- Sentry ----------------------------------------------------------------------------------------------------------
# The server's project and the browser's project (the server hands the browser its DSN with the page). The release is
# baked into the image; the environment is named here.
SENTRY_DSN=
CLIENT_SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# --- screenshot analysis ---------------------------------------------------------------------------------------------
# How long to wait for the OCR service before giving up on a screenshot (ms). The service itself is started by the stack
# and its address (OCR_URL) is set there.
OCR_TIMEOUT_MS=20000
