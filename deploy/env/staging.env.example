# Staging's settings and secrets. Copy to /srv/tectonic/env/staging.env on the box (mode 640, owned by the deploy user)
# and fill it in. It is NOT in git.
#
# Staging is the same image as production with its own database, uploads and Sentry environment. It is publicly reachable,
# so Caddy asks for a shared password on the whole site (except /health); see staging.basic-auth in deploy/README.md.
# Dev-login is ON here, so the test-data generator and "log in as" work without Discord. That is the point of staging and
# the reason it must never share production's SESSION_SECRET or hold anything a stranger should not see.

# --- dev-login -------------------------------------------------------------------------------------------------------
# Dev mode is on only when NODE_ENV is not "production" AND DEV_LOGIN_ENABLED=true (server/src/devMode.ts). The image
# defaults to production, so staging overrides it. That would also drop the Secure flag from the session cookie, so it is
# put back explicitly.
NODE_ENV=staging
DEV_LOGIN_ENABLED=true
COOKIE_SECURE=true

# --- the site's address ----------------------------------------------------------------------------------------------
CLIENT_URL=https://staging.tectonic.bingo
DISCORD_CALLBACK_URL=https://staging.tectonic.bingo/auth/discord/callback

# --- Discord ---------------------------------------------------------------------------------------------------------
# The same application as production is fine: register the staging callback above under OAuth2 > Redirects too.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
ADMIN_DISCORD_IDS=

# --- session ---------------------------------------------------------------------------------------------------------
# Different from production's.
SESSION_SECRET=

# --- clan integrations -----------------------------------------------------------------------------------------------
# Off by default on staging so test data never calls the live APIs; fill in only to try an integration on purpose.
TECTONIC_API_URL=
TECTONIC_API_KEY=
TECTONIC_GUILD_ID=
WOM_API_KEY=
RUNEPROFILE_API_KEY=
USER_AGENT_CONTACT=
PLAYER_STATS_FETCH_DISABLED=true
WOM_COMPETITION_SYNC_DISABLED=true

# --- Sentry ----------------------------------------------------------------------------------------------------------
SENTRY_DSN=
CLIENT_SENTRY_DSN=
SENTRY_ENVIRONMENT=staging

# --- screenshot analysis ---------------------------------------------------------------------------------------------
OCR_TIMEOUT_MS=20000
